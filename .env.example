# Vorlage für .env — Bedeutung jeder Variable: README, Abschnitt „Umgebungsvariablen“.

# Pflicht
DATABASE_URL="postgresql://user:pass@localhost:5432/wiphy"
NEXTAUTH_SECRET=""            # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
ALTCHA_HMAC_KEY=""            # openssl rand -base64 32

# Mailversand
EMAIL_FROM=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# MAIL_SERVICE="GmailWorkspace"   # sonst generisches SMTP:
# SMTP_HOST=""
# SMTP_PORT="587"

# Optional
# AUTH_TRUST_HOST="true"          # hinter Reverse Proxy (Produktion)
# SECURITY_LOG_PEPPER=""          # Standard: NEXTAUTH_SECRET
# NEXT_PUBLIC_SITE_URL=""         # Standard: NEXTAUTH_URL

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.bak/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# deploy per dashboard
/.deploy.log
/.deploy.lock

# graphify: nur graph.json, GRAPH_REPORT.md & Co. einchecken — Snapshots,
# Cache, Visualisierung und rechnerlokale Pfade entstehen bei jedem Lauf neu
graphify-out/20*/
graphify-out/cache/
graphify-out/graph.html
graphify-out/.graphify_python
graphify-out/.graphify_root

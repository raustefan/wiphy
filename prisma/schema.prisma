generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String
  vorname  String
  password String
  titel    String?

  // Mitgliedsdaten
  mitgliedId    Int?      @unique
  aufnahmedatum DateTime?
  role          Role      @default(MEMBER)
  status        Status    @default(KEIN_MITGLIED)
  user          String?

  // Kontakt & Adresse
  plz          String?
  stadt        String?
  strasse      String?
  telefon      String?
  geburtsdatum DateTime?
  land         String?

  //Sonstiges
  website        String?
  studiengang    String?
  studienbeginn  DateTime?
  studienende    DateTime?
  diplomarbeit   String?
  bachelorarbeit String?
  masterarbeit   String?
  dissertation   String?

  //Beruf
  arbeitgeber     String?
  berufsstand     String?
  berufszweig     String?
  position        String?
  praktika        String?
  berufserfahrung String?

  // Nur für Admins sichtbarer Kommentar zu Zahlungs-/Mitgliedschaftsthemen
  zahlungsKommentar String?
  bank              String?
  BLZ               String?
  KTO               String?
  bankeinzug        Boolean?
  zuwendungsbesch   Boolean?
  mahnung           String?
  IBAN              String?
  BIC               String?
  mandatserteilung  DateTime?

  datensperren Boolean?
  ausschluss   Boolean?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  fees              MemberFee[]
  lastLogin         DateTime    @default(now())
  emailVerified     Boolean     @default(false)
  /// Bumped whenever the password changes; JWT sessions issued before this are rejected.
  passwordChangedAt DateTime    @default(now())
}

enum Role {
  MEMBER
  ADMIN
}

enum Status {
  ORDENTLICHES_MITGLIED
  EHRENMITGLIED
  KEIN_MITGLIED
}

model MemberFee {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  // Jahr des Mitgliedsbeitrags (z.B. 2000, 2001, ...)
  jahr      Int
  bezahlt   Boolean @default(false)
  isStudent Boolean @default(false)
  beitrag   Float   @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, jahr])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  content     String
  preview     String   @default("")
  author      String   @default("")
  publishedAt DateTime @default(now())
  imageUrl    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum FeatureFlagKey {
  LOGIN
  PASSWORD_RESET
  REGISTRATION
  EMAIL_CHANGE
  PROFILE_EDIT
  FEE_CHANGES
  MAIL_SERVICES
  USER_CREATION
  USER_DELETION
  BLOG_MANAGEMENT
  EMAIL_VERIFICATION
}

model FeatureFlag {
  key       FeatureFlagKey @id
  enabled   Boolean        @default(true)
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())
}

model RateLimitEntry {
  key          String    @id
  count        Int
  resetAt      DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  @@index([resetAt])
  @@index([blockedUntil])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
}

/// One row per successfully verified ALTCHA solution, keyed by the challenge's
/// HMAC signature. Inserting is what "spends" a solution: the unique constraint
/// makes a replay of the same payload fail, so a single solve can't be reused
/// for the rest of the challenge's validity window.
model SolvedAltchaChallenge {
  signature String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

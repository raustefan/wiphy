generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String
  vorname  String
  password String
  titel    String?

  // Mitgliedsdaten
  mitgliedId    Int?      @unique
  aufnahmedatum DateTime?
  role          Role      @default(MEMBER)
  status        Status    @default(KEIN_MITGLIED)
  user          String?

  // Kontakt & Adresse
  plz          String?
  stadt        String?
  strasse      String?
  telefon      String?
  geburtsdatum DateTime?
  land         String?

  //Sonstiges
  website        String?
  studiengang    String?
  studienbeginn  DateTime?
  studienende    DateTime?
  /// Jahre mit Sonderstatus nach § 5 (z. B. Studierende). Maßgeblich für den
  /// Beitragssatz eines Jahres, solange dafür noch keine `MemberFee`-Zeile
  /// existiert — und damit auch für Jahre, die erst künftig angelegt werden.
  studentYears   Int[]
  diplomarbeit   String?
  bachelorarbeit String?
  masterarbeit   String?
  dissertation   String?

  //Beruf
  arbeitgeber     String?
  berufsstand     String?
  berufszweig     String?
  position        String?
  praktika        String?
  berufserfahrung String?

  // Nur für Admins sichtbarer Kommentar zu Zahlungs-/Mitgliedschaftsthemen
  zahlungsKommentar String?
  bank              String?
  BLZ               String?
  KTO               String?
  bankeinzug        Boolean?
  zuwendungsbesch   Boolean?
  mahnung           String?
  IBAN              String?
  BIC               String?
  mandatserteilung  DateTime?

  datensperren Boolean?
  ausschluss   Boolean?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  fees              MemberFee[]
  applications      MembershipApplication[]
  securityEvents    SecurityEvent[]
  lastLogin         DateTime    @default(now())
  emailVerified     Boolean     @default(false)
  /// Gesetzt, solange eine **Selbstregistrierung** über das öffentliche
  /// Formular noch unbestätigt ist; der Klick auf den Bestätigungslink nullt
  /// den Wert. Steuert beides, was an einer Registrierung erst nach der
  /// Bestätigung passieren darf: die Benachrichtigung der Admins und das
  /// automatische Löschen nach `UNVERIFIED_TTL_HOURS` (siehe
  /// `registrationCleanup.ts`).
  ///
  /// NULL heißt „nicht betroffen“ — und zwar für alle Konten, die es vor
  /// dieser Regel schon gab, und für die von Admins angelegten Konten. Deren
  /// Bestätigung darf beliebig lange dauern, ohne dass sie verschwinden.
  registrationPendingSince DateTime?
  /// Bumped whenever the password changes; JWT sessions issued before this are rejected.
  passwordChangedAt DateTime    @default(now())

  @@index([registrationPendingSince])
}

enum Role {
  MEMBER
  ADMIN
}

enum Status {
  ORDENTLICHES_MITGLIED
  EHRENMITGLIED
  KEIN_MITGLIED
}

model MemberFee {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  // Jahr des Mitgliedsbeitrags (z.B. 2000, 2001, ...)
  jahr      Int
  bezahlt   Boolean @default(false)
  isStudent Boolean @default(false)
  /// Effektiver Betrag. Nur maßgeblich, wenn `beitragManuell` gesetzt ist —
  /// sonst gilt der aus `FeeDefault` berechnete Standardbeitrag.
  beitrag   Float   @default(0)
  /// Ausnahmefall: ein Admin hat den Betrag von Hand abweichend festgelegt.
  /// Solange false, folgt die Zeile automatisch den Standardbeiträgen.
  beitragManuell Boolean @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, jahr])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  content     String
  preview     String   @default("")
  author      String   @default("")
  publishedAt DateTime @default(now())
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images BlogImage[]
}

/// Ein Bild eines Blogbeitrags, Binärdaten inklusive.
///
/// Die Bytes liegen bewusst in der Datenbank und nicht im Dateisystem: der
/// Betrieb ist ein einzelner Server mit einem Backup — und das sichert die
/// Datenbank. Ein Bild, das nur auf der Platte liegt, wäre nach einem Umzug
/// weg, während der Beitrag es weiter referenziert.
///
/// Damit das tragbar bleibt, kommt hier nichts an, was nicht vorher durch
/// `processBlogImage()` gelaufen ist: neu kodiertes WebP, in der Kantenlänge
/// begrenzt und ohne EXIF. Ein 2-MB-Upload landet so als gut 200 KB in der
/// Zeile — sonst würde jede `findMany`-Abfrage über Beiträge die Bilder
/// mitschleppen. Genau deshalb wird `data`/`thumbnail` nirgends per `include`
/// geladen, sondern nur über die Bild-Route einzeln (siehe
/// `blogImageMetaSelect`).
model BlogImage {
  id     String   @id @default(cuid())
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  /// Trägt `postId`, wenn dieses Bild das Titelbild des Beitrags ist, sonst
  /// NULL. Der Unique-Constraint erzwingt damit höchstens ein Titelbild pro
  /// Beitrag — dieselbe Technik wie bei `MembershipApplication.openForUserId`,
  /// und ohne partiellen Index an Prisma vorbei.
  coverForPostId String? @unique

  /// Position in der Galerie. Das Titelbild steht immer auf 0, die weiteren
  /// Bilder folgen lückenlos — die öffentliche Reihenfolge ist damit allein
  /// hieraus ablesbar.
  position Int @default(0)

  /// Alternativtext für Screenreader. Leer erlaubt: dann gilt das Bild als
  /// rein dekorativ und wird mit leerem `alt` ausgeliefert.
  alt String @default("")

  /// Ursprünglicher Dateiname, nur zur Wiedererkennung im Dashboard.
  fileName String @default("")

  /// Immer `image/webp`; als Spalte geführt, damit die Ausliefer-Route den
  /// Content-Type nicht raten muss, falls später ein zweites Format dazukommt.
  mimeType String @default("image/webp")

  width    Int
  height   Int
  /// Größe von `data` in Bytes — erspart der Übersicht im Dashboard das Laden
  /// der Bytes, nur um „wie groß ist das?“ zu beantworten.
  byteSize Int

  /// Vollbild-Variante für Lightbox und Titelbild.
  data      Bytes
  /// Kleine Variante für Listen und den Galerie-Streifen.
  thumbnail Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, position])
}

enum FeatureFlagKey {
  LOGIN
  PASSWORD_RESET
  REGISTRATION
  EMAIL_CHANGE
  PROFILE_EDIT
  FEE_CHANGES
  MAIL_SERVICES
  USER_CREATION
  USER_DELETION
  BLOG_MANAGEMENT
  EMAIL_VERIFICATION
  CONTACT_FORM
  CONTACT_FORM_MAIL
  CONTACT_FORM_STORAGE
  MEMBERSHIP_APPLICATION
  MEMBERSHIP_APPLICATION_MAIL
  MEMBERSHIP_APPLICATION_CONFIRMATION_MAIL
  REGISTRATION_CLEANUP
}

model FeatureFlag {
  key       FeatureFlagKey @id
  enabled   Boolean        @default(true)
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())
}

model RateLimitEntry {
  key          String    @id
  count        Int
  resetAt      DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  @@index([resetAt])
  @@index([blockedUntil])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
}

/// One row per successfully verified ALTCHA solution, keyed by the challenge's
/// HMAC signature. Inserting is what "spends" a solution: the unique constraint
/// makes a replay of the same payload fail, so a single solve can't be reused
/// for the rest of the challenge's validity window.
model SolvedAltchaChallenge {
  signature String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// A submission from the public contact form. Persisted before the notification
/// mail is attempted, so an SMTP outage never loses an enquiry.
model ContactRequest {
  id      String @id @default(cuid())
  name    String
  email   String
  subject String
  message String

  /// SHA-256 of the client IP — enough to correlate abuse, not personal data at rest.
  ipHash    String?
  userAgent String?

  /// 0 = clean. Anything above SPAM_SCORE_MAIL_THRESHOLD is stored but not mailed.
  spamScore Int       @default(0)
  mailedAt  DateTime?
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([handledAt])
}

/// Standard-Beitragssätze je Beitragsjahr, als **Monatsbeträge** — so beschließt
/// sie die Mitgliederversammlung (§ 5). Ein einzelner globaler Satz wäre falsch,
/// sobald der Beitrag geändert wird: dann würden auch abgeschlossene Jahre neu
/// bewertet. Fehlt ein Jahr, gilt das jüngste hinterlegte Jahr davor
/// (siehe `resolveFeeDefault`).
model FeeDefault {
  jahr    Int   @id
  /// Monatsbeitrag für reguläre ordentliche Mitglieder.
  regular Float
  /// Monatsbeitrag für Mitglieder mit Sonderstatus (z. B. Studierende).
  student Float

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum MembershipApplicationStatus {
  EINGEREICHT
  ANGENOMMEN
  ABGELEHNT
  ZURUECKGEZOGEN
}

/// Aufnahmeantrag eines Accounts ohne Mitgliedschaft.
///
/// Die Personendaten stehen hier als *Snapshot* und nicht nur als Verweis auf
/// `User`: das Mitglied darf sein Profil jederzeit weiter bearbeiten, und ohne
/// Kopie würde eine spätere Änderung rückwirkend verändern, was tatsächlich
/// beantragt und beschlossen wurde (Beitragsstufe, SEPA-Mandat).
model MembershipApplication {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  status MembershipApplicationStatus @default(EINGEREICHT)

  /// Trägt `userId` solange der Antrag offen ist, sonst NULL. Erzwingt über den
  /// Unique-Constraint genau einen offenen Antrag pro Account, ohne dass dafür
  /// ein partieller Index an Prisma vorbei angelegt werden müsste.
  openForUserId String? @unique

  // --- Snapshot: Person & Adresse ---
  vorname      String
  name         String
  titel        String?
  geburtsdatum DateTime
  strasse      String
  plz          String
  stadt        String
  land         String
  telefon      String?

  // --- Snapshot: Studium & Beruf ---
  studiengang   String?
  studienbeginn DateTime?
  studienende   DateTime?
  arbeitgeber   String?
  berufsstand   String?
  berufszweig   String?
  position      String?
  /// Jahre, für die die Studierendenermäßigung beantragt wird.
  studentYears  Int[]

  // --- Snapshot: SEPA ---
  kontoinhaber String
  IBAN         String
  BIC          String?
  bank         String?
  bankeinzug   Boolean @default(true)
  /// Datum der Mandatserteilung (= Zeitpunkt des Absendens).
  mandatDatum  DateTime
  /// Wird erst vergeben, wenn dem Verein eine Gläubiger-ID vorliegt.
  mandatsreferenz String?

  // --- Einwilligungen ---
  satzungAccepted     Boolean
  datenschutzAccepted Boolean
  /// Version der zugestimmten Texte, damit später nachweisbar bleibt, worauf
  /// sich die Zustimmung bezog.
  consentVersion      String

  /// Jahresbeiträge zum Zeitpunkt der Antragstellung. Eingefroren, damit eine
  /// Beitragserhöhung zwischen Antrag und Aufnahmebeschluss den Antragsteller
  /// nicht nachträglich überrascht.
  beitragRegularSnapshot Float
  beitragStudentSnapshot Float

  /// SHA-256 der Client-IP — genug zur Missbrauchskorrelation, kein Klardatum.
  ipHash    String?
  userAgent String?

  submittedAt  DateTime  @default(now())
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?
  mailedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, submittedAt])
  @@index([userId])
}

enum SecurityEventType {
  LOGIN
  REGISTRATION
  CONTACT_REQUEST
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  /// Klick auf den Bestätigungslink — schließt Registrierung *und*
  /// E-Mail-Änderung ab. Welcher Fall vorlag, steht in `reason`.
  EMAIL_VERIFICATION
  /// Angeforderte Änderung der eigenen Adresse (Bestätigungsmail verschickt).
  /// Der Klick darauf erscheint als EMAIL_VERIFICATION.
  EMAIL_CHANGE
  /// Eine Selbstregistrierung wurde nicht binnen der Frist bestätigt und das
  /// Konto daraufhin automatisch gelöscht. Kein Zugriffsversuch, sondern das
  /// Ergebnis einer Aufräummaßnahme — steht trotzdem hier, weil es genau die
  /// Kennzahl ist, an der sich Registrierungs-Spam ablesen lässt.
  REGISTRATION_EXPIRED
}

enum SecurityEventOutcome {
  /// Der Vorgang ist durchgelaufen (Login erfolgt, Konto angelegt, Mail raus).
  SUCCESS
  /// Versucht, aber abgelehnt — falsches Passwort, Captcha, ungültiger Token.
  FAILURE
  /// Von einer Schutzmaßnahme gestoppt: Rate Limit, Honeypot, Feature-Flag.
  BLOCKED
}

/// Sicherheitsprotokoll für die öffentlichen Zugangs- und Formularfunktionen.
///
/// Zweck ist ausschließlich die Sicherheit der Verarbeitung (Art. 32 DSGVO):
/// Erkennung von Brute-Force-, Enumeration- und Spam-Angriffen sowie die
/// Auskunft an ein Mitglied, ob jemand versucht hat, sich auf sein Konto
/// anzumelden. Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO.
///
/// Datenminimierung ist im Schema festgeschrieben, nicht nur im Aufrufer:
/// es gibt keine Spalte für Klartext-E-Mail, Klartext-IP, Passwörter,
/// Formularinhalte oder Tokens. Personenbezug entsteht nur über `userId`
/// (eigenes Konto) und die gepfefferten Hashes — und auch der nur befristet,
/// siehe `pruneSecurityEvents()`.
///
/// Pro Versuch entsteht **genau eine** Zeile mit ihrem Ergebnis. „Versuche“ ist
/// damit die Anzahl aller Zeilen eines Typs, „erfolgreich“ die Teilmenge mit
/// `outcome = SUCCESS`; zwei Zeilen pro Vorgang würden dieselbe Handlung
/// doppelt zählen.
model SecurityEvent {
  id      String               @id @default(cuid())
  type    SecurityEventType
  outcome SecurityEventOutcome

  /// Kurzcode für den Grund (z. B. `invalid_credentials`, `rate_limited`).
  /// Bewusst kein Freitext: hier darf nichts landen, was der Nutzer eingegeben hat.
  reason String?

  /// Gesetzt, sobald der Vorgang einem Konto zuzuordnen ist. `SetNull` statt
  /// `Cascade`, damit ein gelöschtes Konto die Angriffsstatistik nicht
  /// verfälscht — die Zeile bleibt, aber ohne Personenbezug (vgl.
  /// `anonymizeSecurityEventsForUser`).
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  /// HMAC der normalisierten E-Mail-Adresse. Nur gesetzt, wenn `userId` fehlt:
  /// bei einem bekannten Konto wäre der Hash redundanter Personenbezug. Erlaubt,
  /// Angriffe auf eine bestimmte (auch nicht existierende) Adresse zu erkennen,
  /// ohne die Adresse selbst zu speichern.
  subjectHash String?

  /// HMAC der Client-IP. Wird nach `PSEUDONYM_RETENTION_DAYS` genullt — die
  /// Datenschutzerklärung sagt 7 Tage für IP-Daten zu.
  ipHash String?

  /// Gekürzter User-Agent, unterliegt derselben 7-Tage-Frist wie `ipHash`.
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, outcome, createdAt])
  @@index([userId, createdAt])
  @@index([subjectHash, createdAt])
  @@index([ipHash, createdAt])
}

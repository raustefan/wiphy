generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  role         Role   @default(MEMBER)

  // Person
  firstName String
  lastName  String
  /// Akademischer Titel für Anschreiben, z. B. „Dr.“.
  title     String?
  birthDate DateTime?
  phone     String?

  // Anschrift — international: Postleitzahl, zweite Zeile und Region sind
  // optional, weil es sie nicht in jedem Land gibt.
  /// Straße und Hausnummer.
  addressLine1 String?
  /// Adresszusatz: c/o, Apartment, Postfach …
  addressLine2 String?
  postalCode   String?
  city         String?
  /// Bundesstaat, Provinz, Kanton — nur wo die Post ihn braucht (USA, Kanada …).
  region       String?
  /// ISO 3166-1 alpha-2 („DE“, „CH“). Altdaten, die sich beim Umstellen nicht
  /// zuordnen ließen, stehen noch im Klartext da — `countryName()` zeigt beides.
  countryCode  String?

  // Mitgliedschaft
  memberNumber  Int?         @unique
  joinedAt      DateTime?
  status        MemberStatus @default(NON_MEMBER)
  /// Jahre mit Sonderstatus nach § 5 (z. B. Studierende) — die einzige Quelle
  /// dafür: Steht ein Jahr hier, gilt für seine Beitragszeile der ermäßigte
  /// Satz, vergangen wie künftig. `MemberFee` speichert den Status nicht.
  studentYears  Int[]
  /// Antwort „Nein“ auf den Hinweis im letzten ermäßigten Jahr: ab diesem Jahr
  /// studiert das Mitglied laut eigener Angabe nicht mehr. Nur, damit der
  /// Hinweis verschwindet und Admins sehen, wer schon geantwortet hat.
  notStudentFromYear Int?
  /// Einwilligung, im Alumni-Kosmos (/dashboard/kosmos) mit Name,
  /// Studiengang, Studienzeit und auf Klick E-Mail-Adresse für andere
  /// Mitglieder sichtbar zu sein, die ebenfalls eingewilligt haben.
  kosmosVisible Boolean      @default(false)
  /// Empfängt Rundmails, die der Vorstand als Newsletter kennzeichnet.
  /// Abbestellen per Link in jeder solchen Mail oder im Mitgliederbereich;
  /// alle übrigen Mails kommen unabhängig davon an.
  newsletter    Boolean      @default(true)
  /// Nur für Admins sichtbarer Kommentar zu Zahlungs-/Mitgliedschaftsthemen.
  adminNote     String?

  // Studium & Beruf
  degreeProgram    String?
  studyStart       DateTime?
  studyEnd         DateTime?
  employer         String?
  /// Angestellt, selbstständig, im Studium …
  employmentStatus String?
  industry         String?
  jobTitle         String?
  linkedinUrl      String?

  // SEPA-Lastschrift. Ohne Mandat bleiben die Bankfelder leer — der Verein zieht
  // dann nichts ein und hat für Kontodaten keine Verwendung.
  /// Teilnahme am Lastschriftverfahren; ohne sie greift der Aufschlag nach § 5 Abs. 5.
  directDebit      Boolean   @default(false)
  accountHolder    String?
  iban             String?
  /// Pflicht für Lastschriften von Konten außerhalb des EWR (CH, GB …), sonst optional.
  bic              String?
  /// Leer = Vorbelegung aus der Mitgliedsnummer (`defaultMandateId`).
  mandateReference String?
  mandateSignedAt  DateTime?

  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  fees                     MemberFee[]
  applications             MembershipApplication[]
  securityEvents           SecurityEvent[]
  lastLoginAt              DateTime                @default(now())
  emailVerified            Boolean                 @default(false)
  /// Gesetzt, solange eine **Selbstregistrierung** über das öffentliche
  /// Formular noch unbestätigt ist; der Klick auf den Bestätigungslink nullt
  /// den Wert. Steuert beides, was an einer Registrierung erst nach der
  /// Bestätigung passieren darf: die Benachrichtigung der Admins und das
  /// automatische Löschen nach `UNVERIFIED_TTL_HOURS` (siehe
  /// `registrationCleanup.ts`).
  ///
  /// NULL heißt „nicht betroffen“ — und zwar für alle Konten, die es vor
  /// dieser Regel schon gab, und für die von Admins angelegten Konten. Deren
  /// Bestätigung darf beliebig lange dauern, ohne dass sie verschwinden.
  registrationPendingSince DateTime?
  /// Bumped whenever the password changes; JWT sessions issued before this are rejected.
  passwordChangedAt        DateTime                @default(now())
  /// Bumped on logout; JWT sessions carrying an older value are rejected, so a
  /// copied cookie dies with the logout instead of living on until it expires.
  sessionVersion           Int                     @default(0)
  /// Login gesperrt, der Datensatz bleibt. So „löscht“ ein Mitglied seinen
  /// Zugang, ohne dass die Mitgliedschaft (und damit die Daten, die der Verein
  /// für sie braucht) endet. Admins heben die Sperre im Adminbereich auf.
  loginDisabled            Boolean                 @default(false)
  /// Fassung der Datenschutzerklärung (`DATENSCHUTZ_VERSION`), die das Konto
  /// zuletzt bestätigt hat. Weicht sie von der aktuellen ab (oder fehlt), muss
  /// sie nach dem Login erst bestätigt werden (`requireUser`).
  privacyPolicyVersion     String?
  terminations             MembershipTermination[]
  backupToken              BackupToken?

  @@index([registrationPendingSince])
}

enum Role {
  MEMBER
  ADMIN
}

enum MemberStatus {
  REGULAR_MEMBER
  HONORARY_MEMBER
  NON_MEMBER
}

model MemberFee {
  id     String @id @default(cuid())
  /// Mit dem Konto gelöscht: Belege über Beiträge sind die Kontoauszüge, eine
  /// Zahlungshistorie gelöschter Konten führt der Verein hier nicht.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// Beitragsjahr (z. B. 2000, 2001, ...).
  year         Int
  paid         Boolean @default(false)
  /// Effektiver Betrag. Nur maßgeblich, wenn `manualAmount` gesetzt ist —
  /// sonst gilt der aus `FeeDefault` berechnete Standardbeitrag.
  amount       Float   @default(0)
  /// Ausnahmefall: ein Admin hat den Betrag von Hand abweichend festgelegt.
  /// Solange false, folgt die Zeile automatisch den Standardbeiträgen.
  manualAmount Boolean @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, year])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  content     String
  preview     String   @default("")
  author      String   @default("")
  publishedAt DateTime @default(now())
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images BlogImage[]

  /// Optionaler Rückbezug auf den Termin, über den dieser Beitrag berichtet.
  /// `SetNull` statt `Cascade`: ein gelöschter Termin darf den Rückblick nicht
  /// mitnehmen — der Beitrag verliert nur seine Verknüpfung.
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId String?

  @@index([eventId])
}

/// Ein Vereinstermin — Stammtisch, Exkursion, Sondervorlesung,
/// Mitgliederversammlung.
///
/// Die Termine sind öffentlich: die Seite `/termine` zeigt kommende Termine,
/// vergangene erst auf Klick. Was „vergangen“ heißt, entscheidet ausschließlich
/// `end ?? start` gegen die aktuelle Zeit — es gibt bewusst kein Statusfeld,
/// das jemand von Hand nachziehen müsste.
model Event {
  id String @id @default(cuid())

  title       String
  /// Ein bis zwei Sätze für Übersicht, Startseite und Ankündigungsmail.
  summary     String @default("")
  /// Ausführliche Beschreibung als Markdown, wie beim Blog.
  description String @default("")

  start  DateTime
  /// Ende, falls bekannt. Ohne Angabe gilt der Termin am Starttag als vorbei
  /// (siehe `eventEnd()`), und die Kalenderdatei setzt eine Standarddauer.
  end    DateTime?
  /// Ganztägig: Uhrzeiten werden weder angezeigt noch in die `.ics` geschrieben.
  allDay Boolean   @default(false)

  /// Name des Orts, z. B. „Universität Ulm, Hörsaal H3“.
  location  String @default("")
  /// Anschrift, getrennt vom Namen — sie landet als eigene Zeile in der
  /// Kalenderdatei und im Kartenlink.
  address   String @default("")
  /// Ein frei wählbarer Link (Anmeldung, Stream, Infoseite …) mit Sichttext.
  linkUrl   String @default("")
  /// Sichttext des Links, z. B. „Mehr erfahren“. Leer: siehe `eventLinkLabel()`.
  linkLabel String @default("")

  /// Wie beim Blog: unveröffentlichte Termine sind Entwürfe und öffentlich
  /// unsichtbar, auch wenn ihre ID bekannt ist.
  published Boolean @default(false)

  /// Blogbeiträge, die über den Termin berichten (Rückblick).
  posts BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, start])
  @@index([start])
}

/// Ein Bild eines Blogbeitrags, Binärdaten inklusive.
///
/// Die Bytes liegen bewusst in der Datenbank und nicht im Dateisystem: der
/// Betrieb ist ein einzelner Server mit einem Backup — und das sichert die
/// Datenbank. Ein Bild, das nur auf der Platte liegt, wäre nach einem Umzug
/// weg, während der Beitrag es weiter referenziert.
///
/// Damit das tragbar bleibt, kommt hier nichts an, was nicht vorher durch
/// `processBlogImage()` gelaufen ist: neu kodiertes WebP, in der Kantenlänge
/// begrenzt und ohne EXIF. Ein 2-MB-Upload landet so als gut 200 KB in der
/// Zeile — sonst würde jede `findMany`-Abfrage über Beiträge die Bilder
/// mitschleppen. Genau deshalb wird `data`/`thumbnail` nirgends per `include`
/// geladen, sondern nur über die Bild-Route einzeln (siehe
/// `blogImageMetaSelect`).
model BlogImage {
  id     String   @id @default(cuid())
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  /// Trägt `postId`, wenn dieses Bild das Titelbild des Beitrags ist, sonst
  /// NULL. Der Unique-Constraint erzwingt damit höchstens ein Titelbild pro
  /// Beitrag — dieselbe Technik wie bei `MembershipApplication.openForUserId`,
  /// und ohne partiellen Index an Prisma vorbei.
  coverForPostId String? @unique

  /// Position in der Galerie. Das Titelbild steht immer auf 0, die weiteren
  /// Bilder folgen lückenlos — die öffentliche Reihenfolge ist damit allein
  /// hieraus ablesbar.
  position Int @default(0)

  /// Alternativtext für Screenreader. Leer erlaubt: dann gilt das Bild als
  /// rein dekorativ und wird mit leerem `alt` ausgeliefert.
  alt String @default("")

  /// Ursprünglicher Dateiname, nur zur Wiedererkennung im Dashboard.
  fileName String @default("")

  /// Immer `image/webp`; als Spalte geführt, damit die Ausliefer-Route den
  /// Content-Type nicht raten muss, falls später ein zweites Format dazukommt.
  mimeType String @default("image/webp")

  width    Int
  height   Int
  /// Größe von `data` in Bytes — erspart der Übersicht im Dashboard das Laden
  /// der Bytes, nur um „wie groß ist das?“ zu beantworten.
  byteSize Int

  /// Vollbild-Variante für Lightbox und Titelbild.
  data      Bytes
  /// Kleine Variante für Listen und den Galerie-Streifen.
  thumbnail Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, position])
}

/// Ein Vorstandsmitglied für die öffentliche Seite `/vorstand` und die
/// Mail-Signatur. Ersetzt die zuvor im Code fest verdrahteten Listen in
/// `src/app/vorstand/page.tsx` und `src/lib/email/branding.ts`.
model BoardMember {
  id       String @id @default(cuid())
  name     String
  role     String
  linkedin String @default("")

  /// Reihenfolge auf /vorstand und im Dashboard.
  position    Int     @default(0)
  /// Entwurf vs. öffentlich sichtbar — wie BlogPost.published.
  published   Boolean @default(false)
  /// Ob dieses Mitglied in der Mail-Signatur genannt wird.
  inSignature Boolean @default(false)

  photo BoardMemberPhoto?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, position])
}

/// Profilfoto eines Vorstandsmitglieds, quadratisch zugeschnitten und als
/// WebP re-kodiert (siehe `processBoardPhoto()`) — dieselbe Begründung wie bei
/// `BlogImage`: die Bytes liegen in der Datenbank, weil der Betrieb nur ein
/// Backup davon kennt.
model BoardMemberPhoto {
  id       String      @id @default(cuid())
  member   BoardMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String      @unique

  mimeType String @default("image/webp")
  width    Int
  height   Int
  byteSize Int
  data     Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FeatureFlagKey {
  LOGIN
  PASSWORD_RESET
  REGISTRATION
  EMAIL_CHANGE
  PROFILE_EDIT
  FEE_CHANGES
  MAIL_SERVICES
  USER_CREATION
  USER_DELETION
  BLOG_MANAGEMENT
  EMAIL_VERIFICATION
  CONTACT_FORM
  CONTACT_FORM_MAIL
  CONTACT_FORM_STORAGE
  MEMBERSHIP_APPLICATION
  MEMBERSHIP_APPLICATION_MAIL
  MEMBERSHIP_APPLICATION_CONFIRMATION_MAIL
  REGISTRATION_CLEANUP
  EVENT_MANAGEMENT
  BOARD_MANAGEMENT
  MEMBERSHIP_TERMINATION
  MEMBERSHIP_TERMINATION_MAIL
  MEMBERSHIP_TERMINATION_CONFIRMATION_MAIL
  ACCOUNT_NOTICE_MAIL
  KOSMOS
  PDF_DOCUMENTS
  EMAIL_DELIVERY
  PAGE_TERMINE
  PAGE_BLOG
  PAGE_GESCHICHTE
  PAGE_VORSTAND
  PAGE_SATZUNG
}

model FeatureFlag {
  key       FeatureFlagKey @id
  enabled   Boolean        @default(true)
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())
}

model RateLimitEntry {
  key          String    @id
  count        Int
  resetAt      DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  @@index([resetAt])
  @@index([blockedUntil])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/// Einmal-Link für das Datenbank-Backup (`/dashboard/server`). Eine Zeile je
/// Admin: ein neuer Link überschreibt den alten, eingelöst wird die Zeile
/// gelöscht. Bewusst kein Protokoll — nach Einlösen oder Ablauf bleibt nichts.
model BackupToken {
  userId  String   @id
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token   String   @unique
  expires DateTime
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
}

/// One row per successfully verified ALTCHA solution, keyed by the challenge's
/// HMAC signature. Inserting is what "spends" a solution: the unique constraint
/// makes a replay of the same payload fail, so a single solve can't be reused
/// for the rest of the challenge's validity window.
model SolvedAltchaChallenge {
  signature String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// A submission from the public contact form. Persisted before the notification
/// mail is attempted, so an SMTP outage never loses an enquiry.
model ContactRequest {
  id      String @id @default(cuid())
  name    String
  email   String
  subject String
  message String

  /// SHA-256 of the client IP — enough to correlate abuse, not personal data at rest.
  ipHash    String?
  userAgent String?

  /// 0 = clean. Anything above SPAM_SCORE_MAIL_THRESHOLD is stored but not mailed.
  spamScore Int       @default(0)
  mailedAt  DateTime?
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([handledAt])
}

/// Standard-Beitragssätze je Beitragsjahr, als **Monatsbeträge** — so beschließt
/// sie die Mitgliederversammlung (§ 5). Ein einzelner globaler Satz wäre falsch,
/// sobald der Beitrag geändert wird: dann würden auch abgeschlossene Jahre neu
/// bewertet. Fehlt ein Jahr, gilt das jüngste hinterlegte Jahr davor
/// (siehe `resolveFeeDefault`).
model FeeDefault {
  year    Int   @id
  /// Monatsbeitrag für reguläre ordentliche Mitglieder.
  regular Float
  /// Monatsbeitrag für Mitglieder mit Sonderstatus (z. B. Studierende).
  student Float

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum MembershipApplicationStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// Aufnahmeantrag eines Accounts ohne Mitgliedschaft.
///
/// Die Personendaten stehen hier als *Snapshot* und nicht nur als Verweis auf
/// `User`: das Mitglied darf sein Profil jederzeit weiter bearbeiten, und ohne
/// Kopie würde eine spätere Änderung rückwirkend verändern, was tatsächlich
/// beantragt und beschlossen wurde (Beitragsstufe, SEPA-Mandat).
model MembershipApplication {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  status MembershipApplicationStatus @default(SUBMITTED)

  /// Trägt `userId` solange der Antrag offen ist, sonst NULL. Erzwingt über den
  /// Unique-Constraint genau einen offenen Antrag pro Account, ohne dass dafür
  /// ein partieller Index an Prisma vorbei angelegt werden müsste.
  openForUserId String? @unique

  // --- Snapshot: Person & Adresse ---
  firstName    String
  lastName     String
  title        String?
  birthDate    DateTime
  addressLine1 String
  addressLine2 String?
  postalCode   String?
  city         String
  region       String?
  /// Wie `User.countryCode`; Anträge von vor der Umstellung tragen Klartext.
  countryCode  String
  phone        String?

  // --- Snapshot: Studium & Beruf ---
  degreeProgram    String?
  studyStart       DateTime?
  studyEnd         DateTime?
  employer         String?
  employmentStatus String?
  industry         String?
  jobTitle         String?
  /// Jahre, für die die Studierendenermäßigung beantragt wird.
  studentYears     Int[]

  // --- Snapshot: SEPA ---
  /// Bankdaten und Mandatsdatum fehlen, wenn kein Lastschriftmandat erteilt
  /// wurde: ohne Mandat zieht der Verein nichts ein, hat für die Kontodaten
  /// also keine Verwendung — und erhebt sie deshalb gar nicht erst.
  accountHolder    String?
  iban             String?
  bic              String?
  directDebit      Boolean   @default(true)
  /// Datum der Mandatserteilung (= Zeitpunkt des Absendens), sonst leer.
  mandateSignedAt  DateTime?
  /// Wird erst vergeben, wenn dem Verein eine Gläubiger-ID vorliegt.
  mandateReference String?

  // --- Einwilligungen ---
  bylawsAccepted  Boolean
  privacyAccepted Boolean
  /// Version der zugestimmten Texte, damit später nachweisbar bleibt, worauf
  /// sich die Zustimmung bezog.
  consentVersion  String

  /// Jahresbeiträge zum Zeitpunkt der Antragstellung. Eingefroren, damit eine
  /// Beitragserhöhung zwischen Antrag und Aufnahmebeschluss den Antragsteller
  /// nicht nachträglich überrascht.
  regularFeeSnapshot Float
  studentFeeSnapshot Float

  /// SHA-256 der Client-IP — genug zur Missbrauchskorrelation, kein Klardatum.
  ipHash    String?
  userAgent String?

  submittedAt  DateTime  @default(now())
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?
  mailedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, submittedAt])
  @@index([userId])
}

enum MembershipTerminationStatus {
  /// Wirksam zu `effectiveAt`; vollzogen, sobald `completedAt` gesetzt ist.
  CONFIRMED
  /// Altbestand: vom Mitglied zurückgenommene Kündigung zum Jahresende.
  WITHDRAWN
}

/// Warum die Mitgliedschaft endet. Austritte erklärt das Mitglied selbst,
/// Ausschluss und Tod (§ 6 Satzung) trägt der Vorstand ein.
enum TerminationReason {
  RESIGNATION
  EXCLUSION
  DECEASED
}

/// Ende einer Mitgliedschaft.
///
/// Tritt ein Mitglied selbst aus, endet die Mitgliedschaft sofort (Zustimmung
/// des Vorstands zur vorzeitigen Beendigung, abweichend von § 6 Satzung). Ohne
/// offene Beiträge wird das Konto gleich gelöscht und es entsteht keine Zeile;
/// sonst hält sie `deleteWhenSettled` fest, bis die Beiträge bezahlt sind.
///
/// Austritte durch den Vorstand (Ausschluss, Tod) bleiben als Nachweis stehen
/// und werden drei Jahre danach gelöscht (Regelverjährung, `processTerminations`).
model MembershipTermination {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  status MembershipTerminationStatus @default(CONFIRMED)
  reason TerminationReason           @default(RESIGNATION)

  /// `userId`, solange die Kündigung noch nicht vollzogen ist — gleicher
  /// Trick wie bei `MembershipApplication.openForUserId`.
  openForUserId String? @unique

  submittedAt DateTime @default(now())
  /// Letzter Tag der Mitgliedschaft (Datum, 00:00 UTC — wie alle reinen
  /// Datumsfelder). Beim Eingang berechnet, bei der Bestätigung korrigierbar.
  effectiveAt DateTime
  /// Wunsch des Mitglieds: nach dem Austritt als Konto ohne Mitgliedschaft
  /// weiter anmelden können. Sonst wird der Login zum Austritt gesperrt.
  keepAccount Boolean  @default(false)

  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?
  /// Gesetzt, sobald der Status des Mitglieds auf NON_MEMBER umgestellt wurde.
  completedAt  DateTime?
  /// Sofortiger Austritt mit offenen Beiträgen: das Konto wird gelöscht,
  /// sobald keine mehr offen sind (`processTerminations`).
  deleteWhenSettled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, effectiveAt])
  @@index([userId])
}

enum SecurityEventType {
  LOGIN
  REGISTRATION
  CONTACT_REQUEST
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  /// Klick auf den Bestätigungslink — schließt Registrierung *und*
  /// E-Mail-Änderung ab. Welcher Fall vorlag, steht in `reason`.
  EMAIL_VERIFICATION
  /// Angeforderte Änderung der eigenen Adresse (Bestätigungsmail verschickt).
  /// Der Klick darauf erscheint als EMAIL_VERIFICATION.
  EMAIL_CHANGE
  /// Eine Selbstregistrierung wurde nicht binnen der Frist bestätigt und das
  /// Konto daraufhin automatisch gelöscht. Kein Zugriffsversuch, sondern das
  /// Ergebnis einer Aufräummaßnahme — steht trotzdem hier, weil es genau die
  /// Kennzahl ist, an der sich Registrierungs-Spam ablesen lässt.
  REGISTRATION_EXPIRED
}

enum SecurityEventOutcome {
  /// Der Vorgang ist durchgelaufen (Login erfolgt, Konto angelegt, Mail raus).
  SUCCESS
  /// Versucht, aber abgelehnt — falsches Passwort, Captcha, ungültiger Token.
  FAILURE
  /// Von einer Schutzmaßnahme gestoppt: Rate Limit, Honeypot, Feature-Flag.
  BLOCKED
}

/// Sicherheitsprotokoll für die öffentlichen Zugangs- und Formularfunktionen.
///
/// Zweck ist ausschließlich die Sicherheit der Verarbeitung (Art. 32 DSGVO):
/// Erkennung von Brute-Force-, Enumeration- und Spam-Angriffen sowie die
/// Auskunft an ein Mitglied, ob jemand versucht hat, sich auf sein Konto
/// anzumelden. Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO.
///
/// Datenminimierung ist im Schema festgeschrieben, nicht nur im Aufrufer:
/// es gibt keine Spalte für Klartext-E-Mail, Klartext-IP, Passwörter,
/// Formularinhalte oder Tokens. Personenbezug entsteht nur über `userId`
/// (eigenes Konto) und die gepfefferten Hashes — und auch der nur befristet,
/// siehe `pruneSecurityEvents()`.
///
/// Pro Versuch entsteht **genau eine** Zeile mit ihrem Ergebnis. „Versuche“ ist
/// damit die Anzahl aller Zeilen eines Typs, „erfolgreich“ die Teilmenge mit
/// `outcome = SUCCESS`; zwei Zeilen pro Vorgang würden dieselbe Handlung
/// doppelt zählen.
model SecurityEvent {
  id      String               @id @default(cuid())
  type    SecurityEventType
  outcome SecurityEventOutcome

  /// Kurzcode für den Grund (z. B. `invalid_credentials`, `rate_limited`).
  /// Bewusst kein Freitext: hier darf nichts landen, was der Nutzer eingegeben hat.
  reason String?

  /// Gesetzt, sobald der Vorgang einem Konto zuzuordnen ist. `SetNull` statt
  /// `Cascade`, damit ein gelöschtes Konto die Angriffsstatistik nicht
  /// verfälscht — die Zeile bleibt, aber ohne Personenbezug (vgl.
  /// `anonymizeSecurityEventsForUser`).
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  /// HMAC der normalisierten E-Mail-Adresse. Nur gesetzt, wenn `userId` fehlt:
  /// bei einem bekannten Konto wäre der Hash redundanter Personenbezug. Erlaubt,
  /// Angriffe auf eine bestimmte (auch nicht existierende) Adresse zu erkennen,
  /// ohne die Adresse selbst zu speichern.
  subjectHash String?

  /// HMAC der Client-IP. Wird nach `PSEUDONYM_RETENTION_DAYS` genullt — die
  /// Datenschutzerklärung sagt 7 Tage für IP-Daten zu.
  ipHash String?

  /// Gekürzter User-Agent, unterliegt derselben 7-Tage-Frist wie `ipHash`.
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, outcome, createdAt])
  @@index([userId, createdAt])
  @@index([subjectHash, createdAt])
  @@index([ipHash, createdAt])
}

/// Versandprotokoll der Mails aus dem Dashboard (Rundmail und Direktmail).
/// Bewusst ohne Inhalt: Betreff (als Vorlage, Platzhalter unersetzt), Zeitpunkt
/// und Empfänger — bei einer einzelnen Person deren Adresse, sonst nur Gruppe
/// und Anzahl. Gelöscht nach `SENT_MAIL_RETENTION_DAYS` (`mailHistory.ts`).
model SentMail {
  id             String   @id @default(cuid())
  subject        String
  /// Empfängergruppe (`ALL` oder ein `Status`); NULL bei ausgewählten Empfängern.
  recipientGroup String?
  recipientCount Int
  /// Nur bei genau einem ausgewählten Empfänger. Beim Löschen des Kontos genullt.
  recipientEmail String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([recipientEmail])
}
